# Postgres (used by both services/api and services/ingestion)
DATABASE_URL=postgresql://hawq:hawq_dev_password@localhost:5432/hawq

# API service
PORT=4000
# Required to create or resolve HawQ-authored prediction markets.
HAWQ_MARKETS_ADMIN_KEY=replace-with-a-long-random-secret

# Chain RPC endpoints — public defaults are set in code; override for
# higher rate limits (Alchemy/Quicknode/Tatum) once ingestion volume grows.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# NEVER commit a real key here. Rotate any key that has ever been committed.
